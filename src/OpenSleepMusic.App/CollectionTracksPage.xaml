<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="OpenSleepMusic.App.CollectionTracksPage"
             BackgroundColor="#0B1020">
    <Grid RowDefinitions="Auto,*" Padding="18" RowSpacing="12">
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
            <Button Text="‹" FontSize="26" Clicked="OnCloseClicked" BackgroundColor="#252C45" TextColor="White" />
            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                <Label x:Name="TitleLabel" FontSize="22" FontAttributes="Bold" TextColor="#F7F3FF" />
                <Label x:Name="SummaryLabel" FontSize="12" TextColor="#9E9AAF" />
            </VerticalStackLayout>
        </Grid>
        <CollectionView Grid.Row="1" x:Name="TracksView" SelectionMode="Single" SelectionChanged="OnSelectionChanged">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Grid Padding="8" RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="3" Opacity="{Binding Opacity}">
                        <Label Text="{Binding LocalTrack.Track.Title}" TextColor="#F7F3FF" LineBreakMode="TailTruncation" />
                        <Label Grid.Row="1" Text="{Binding LocalTrack.Track.Creator}" FontSize="11" TextColor="#9E9AAF" LineBreakMode="TailTruncation" />
                        <Button Grid.Column="1" Grid.RowSpan="2" Text="{Binding FavoriteGlyph}" FontSize="20" WidthRequest="40" HeightRequest="38" Padding="0"
                                CommandParameter="{Binding .}" Clicked="OnFavoriteClicked" BackgroundColor="Transparent" TextColor="{Binding FavoriteColor}" />
                        <Button Grid.Column="2" Grid.RowSpan="2" Text="ⓘ" FontSize="16" WidthRequest="40" HeightRequest="38" Padding="0"
                                CommandParameter="{Binding .}" Clicked="OnDetailsClicked" BackgroundColor="Transparent" TextColor="#9E9AAF" />
                        <Label Grid.Column="3" Grid.RowSpan="2" Text="▶" TextColor="#8A7FFF" VerticalOptions="Center" Margin="3,0,0,0" />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
