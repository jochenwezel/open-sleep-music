<?xml version="1.0" encoding="utf-8"?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit" x:Class="OpenSleepMusic.App.MainPage" BackgroundColor="#0B1020" Title="Schlafwelten">
    <Grid RowDefinitions="Auto,*,Auto,Auto" Padding="28" RowSpacing="16">
        <VerticalStackLayout Spacing="4">
            <Label Text="open sleep music" FontSize="30" FontAttributes="Bold" TextColor="#F7F3FF" />
            <Label Text="Kostenlose Klänge für eine ruhige Nacht" TextColor="#B8B5C8" />
        </VerticalStackLayout>
        <Grid Grid.Row="1" ColumnDefinitions="3*,2*" ColumnSpacing="18">
            <VerticalStackLayout Spacing="10">
                <Label Text="Schlafwelten" FontSize="19" FontAttributes="Bold" TextColor="#F7F3FF" />
                <CollectionView x:Name="WorldsView" SelectionMode="None">
                    <CollectionView.ItemsLayout>
                        <GridItemsLayout Orientation="Vertical" Span="2" HorizontalItemSpacing="12" VerticalItemSpacing="12" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border BackgroundColor="#171D31" Stroke="#29304B" Padding="14">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="16" />
                                </Border.StrokeShape>
                                <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="Auto,*" ColumnSpacing="10" RowSpacing="5">
                                    <Label Text="{Binding Icon}" FontSize="27" Grid.RowSpan="2" />
                                    <Label Grid.Column="1" Text="{Binding Name}" FontSize="16" FontAttributes="Bold" TextColor="#F7F3FF" />
                                    <Label Grid.Row="1" Grid.Column="1" Text="{Binding Description}" FontSize="11" TextColor="#B8B5C8" MaxLines="2" />
                                    <Button Grid.Row="2" Grid.ColumnSpan="2" Text="Herunterladen" CommandParameter="{Binding .}" Clicked="OnDownloadClicked" BackgroundColor="#7367F0" TextColor="White" CornerRadius="10" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>
            <VerticalStackLayout Grid.Column="1" Spacing="10">
                <Grid ColumnDefinitions="*,Auto">
                    <Label Text="Meine Musik" FontSize="19" FontAttributes="Bold" TextColor="#F7F3FF" />
                    <Button Grid.Column="1" Text="Aktualisieren" Clicked="OnRefreshLibraryClicked" BackgroundColor="#252C45" TextColor="#F7F3FF" />
                </Grid>
                <Label x:Name="LibraryEmptyLabel" Text="Noch keine Musik heruntergeladen." TextColor="#9E9AAF" />
                <CollectionView x:Name="LibraryView" SelectionMode="Single" SelectionChanged="OnLibrarySelectionChanged">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="8" RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto">
                                <Label Text="{Binding Track.Title}" TextColor="#F7F3FF" LineBreakMode="TailTruncation" />
                                <Label Grid.Row="1" Text="{Binding SleepWorld.Name}" FontSize="11" TextColor="#9E9AAF" />
                                <Label Grid.Column="1" Grid.RowSpan="2" Text="▶" TextColor="#8A7FFF" VerticalOptions="Center" />
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>
        </Grid>
        <Border Grid.Row="2" BackgroundColor="#171D31" Stroke="#29304B" Padding="14">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="16" />
            </Border.StrokeShape>
            <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" RowSpacing="7">
                <Button Text="⏮" Clicked="OnPreviousClicked" BackgroundColor="#252C45" TextColor="White" />
                <VerticalStackLayout Grid.Column="1">
                    <Label x:Name="NowPlayingLabel" Text="Titel aus ‚Meine Musik‘ auswählen" FontAttributes="Bold" TextColor="#F7F3FF" LineBreakMode="TailTruncation" />
                    <Label x:Name="NowPlayingDetailLabel" Text="Bereit" FontSize="11" TextColor="#9E9AAF" />
                </VerticalStackLayout>
                <Button Grid.Column="2" Text="⏭" Clicked="OnNextClicked" BackgroundColor="#252C45" TextColor="White" />
                <Button Grid.Row="1" x:Name="PlayPauseButton" Text="▶" Clicked="OnPlayPauseClicked" BackgroundColor="#7367F0" TextColor="White" />
                <Slider Grid.Row="1" Grid.Column="1" x:Name="PositionSlider" Minimum="0" Maximum="1" DragStarted="OnPositionDragStarted" DragCompleted="OnPositionDragCompleted" />
                <Label Grid.Row="1" Grid.Column="2" x:Name="TimeLabel" Text="0:00 / 0:00" TextColor="#DAD6E8" VerticalOptions="Center" />
                <Label Grid.Row="2" Text="Schlaf-Timer" TextColor="#B8B5C8" VerticalOptions="Center" />
                <Picker Grid.Row="2" Grid.Column="1" x:Name="SleepTimerPicker" Title="Aus" SelectedIndexChanged="OnSleepTimerChanged" TextColor="#F7F3FF" />
                <Label Grid.Row="2" Grid.Column="2" x:Name="SleepTimerLabel" Text="Aus" TextColor="#9E9AAF" VerticalOptions="Center" />
            </Grid>
        </Border>
        <Grid Grid.Row="3" ColumnDefinitions="*,Auto">
            <VerticalStackLayout>
                <Label x:Name="StatusLabel" Text="Bereit" TextColor="#DAD6E8" />
                <ProgressBar x:Name="DownloadProgress" Progress="0" ProgressColor="#8A7FFF" />
            </VerticalStackLayout>
            <Button Grid.Column="1" Text="Download-Ordner öffnen" Clicked="OnOpenFolderClicked" BackgroundColor="#252C45" TextColor="#F7F3FF" />
        </Grid>
        <toolkit:MediaElement x:Name="Player" IsVisible="False" ShouldAutoPlay="False" MediaEnded="OnMediaEnded" MediaFailed="OnMediaFailed" StateChanged="OnPlayerStateChanged" />
    </Grid>
</ContentPage>