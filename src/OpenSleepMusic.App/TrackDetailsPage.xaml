<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="OpenSleepMusic.App.TrackDetailsPage"
             BackgroundColor="#0B1020"
             Title="Titelinformationen">
    <Grid RowDefinitions="Auto,*,Auto" Padding="24" RowSpacing="18">
        <Grid ColumnDefinitions="*,Auto">
            <VerticalStackLayout Spacing="4">
                <Label Text="Titelinformationen" FontSize="26" FontAttributes="Bold" TextColor="#F7F3FF" />
                <Label Text="Quelle, Lizenz und lokale Datei" TextColor="#B8B5C8" />
            </VerticalStackLayout>
            <Button Grid.Column="1" Text="✕" Clicked="OnCloseClicked" BackgroundColor="#252C45" TextColor="White" />
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="15">
                <Label x:Name="TitleLabel" FontSize="22" FontAttributes="Bold" TextColor="#F7F3FF" />
                <Grid ColumnDefinitions="130,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="10">
                    <Label Text="Urheber/Interpret" TextColor="#9E9AAF" />
                    <Label Grid.Column="1" x:Name="CreatorLabel" TextColor="#F7F3FF" />
                    <Label Grid.Row="1" Text="Schlafwelt" TextColor="#9E9AAF" />
                    <Label Grid.Row="1" Grid.Column="1" x:Name="WorldLabel" TextColor="#F7F3FF" />
                    <Label Grid.Row="2" Text="Dauer" TextColor="#9E9AAF" />
                    <Label Grid.Row="2" Grid.Column="1" x:Name="DurationLabel" TextColor="#F7F3FF" />
                    <Label Grid.Row="3" Text="Lizenz" TextColor="#9E9AAF" />
                    <Label Grid.Row="3" Grid.Column="1" x:Name="LicenseLabel" TextColor="#F7F3FF" />
                    <Label Grid.Row="4" Text="Lokale Datei" TextColor="#9E9AAF" />
                    <Label Grid.Row="4" Grid.Column="1" x:Name="FileLabel" TextColor="#F7F3FF" LineBreakMode="CharacterWrap" />
                </Grid>

                <Label Text="Die Lizenzangabe stammt von der dokumentierten Quellseite der konkreten Aufnahme." TextColor="#B8B5C8" />
                <HorizontalStackLayout Spacing="10">
                    <Button Text="Quellseite öffnen" Clicked="OnSourceClicked" BackgroundColor="#7367F0" TextColor="White" />
                    <Button Text="Lizenz öffnen" Clicked="OnLicenseClicked" BackgroundColor="#252C45" TextColor="White" />
                </HorizontalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

        <Label Grid.Row="2" x:Name="StatusLabel" TextColor="#DAD6E8" />
    </Grid>
</ContentPage>
