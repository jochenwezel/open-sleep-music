<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\OpenSleepMusic.Core\OpenSleepMusic.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\src\OpenSleepMusic.App\Visuals\PlaybackVisualCatalog.cs" Link="AppVisuals\PlaybackVisualCatalog.cs" />
    <Compile Include="..\..\src\OpenSleepMusic.App\Navigation\ModalPlaybackNavigation.cs" Link="AppNavigation\ModalPlaybackNavigation.cs" />
    <Compile Include="..\..\src\OpenSleepMusic.App\Localization\AppLanguage.cs" Link="AppLocalization\AppLanguage.cs" />
    <Compile Include="..\..\src\OpenSleepMusic.App\AppStateStore.cs" Link="AppState\AppStateStore.cs" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="../../src/OpenSleepMusic.App/*.xaml" LogicalName="Localization.%(Filename)%(Extension)" />
    <EmbeddedResource Include="../../tools/media-catalog-blacklist.json" LogicalName="OpenSleepMusic.Core.Tests.media-catalog-blacklist.json" />
    <EmbeddedResource Include="../../src/OpenSleepMusic.App/Platforms/Android/AndroidManifest.xml" LogicalName="AudioStorage.AndroidManifest.xml" />
    <EmbeddedResource Include="../../src/OpenSleepMusic.App/Platforms/Android/Resources/xml/backup_rules.xml" LogicalName="AudioStorage.backup_rules.xml" />
    <EmbeddedResource Include="../../src/OpenSleepMusic.App/Platforms/Android/Resources/xml/data_extraction_rules.xml" LogicalName="AudioStorage.data_extraction_rules.xml" />
  </ItemGroup>
</Project>
